{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/session_start.js",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\session_start.js\"",
            "statusMessage": "Loading kxh-kit handoff context"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/session_start.js",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\session_start.js\"",
            "statusMessage": "Loading compact kxh-kit context"
          }
        ]
      }
    ]
  }
}
