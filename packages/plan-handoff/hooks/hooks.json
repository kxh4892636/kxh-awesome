{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/session_start.py",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\session_start.py\"",
            "statusMessage": "Loading plan handoff context"
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/session_start.py",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\session_start.py\"",
            "statusMessage": "Loading compact handoff context"
          }
        ]
      }
    ]
  }
}
